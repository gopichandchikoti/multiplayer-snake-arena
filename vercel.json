{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "apps/client",
      "framework": "vite",
      "buildCommand": "pnpm run build",
      "outputDirectory": "dist"
    },
    "server": {
      "root": "apps/server",
      "framework": "node",
      "runtime": "nodejs22.x",
      "entrypoint": "src/vercel.ts",
      "buildCommand": "pnpm run typecheck"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "server" } },
    { "source": "/ws", "destination": { "service": "server" } },
    { "source": "/healthz", "destination": { "service": "server" } },
    { "source": "/readyz", "destination": { "service": "server" } },
    { "source": "/(.*)", "destination": { "service": "client" } }
  ]
}
