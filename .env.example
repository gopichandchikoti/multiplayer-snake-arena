# Copy to .env for local overrides. No secrets are required to run the game.

# Port the combined HTTP + WebSocket server listens on.
PORT=5722
HOST=127.0.0.1

# Comma separated browser origins allowed to open a WebSocket. Empty = same host only.
ALLOWED_ORIGINS=

# development | production. Production rejects WebSocket clients that send no Origin header.
NODE_ENV=development

# Optional path of a JSON file that makes the leaderboard survive server restarts.
# Empty = in-memory leaderboard (resets on restart, and the UI says so).
LEADERBOARD_FILE=

# Directory holding the built client (apps/client/dist). Empty = auto-detect.
STATIC_DIR=

# Abuse limits (defaults shown).
MAX_CONNECTIONS_PER_IP=8
MAX_ROOMS=200
